# Copy this file to .env in the same directory and fill in the real values.
# .env is gitignored — never commit real credentials.

# ─── Claude.ai session (drives Clawd's corner usage rings) ───────────────────
# The daemon polls claude.ai/api/organizations/{ORG_ID}/usage every 2 min and
# forwards the five_hour + seven_day percentages to Clawd. Auth is a browser
# session cookie, not an API key.
#
# To grab both values:
#   1. Open https://claude.ai/settings/usage in a browser (not the desktop app)
#   2. Cmd+Opt+I → Network tab → Cmd+R to reload
#   3. Filter box: usage — click the row named "usage" (status 200)
#   4. Headers tab → Request URL → copy the UUID between /organizations/ and /usage
#      → that's CLAUDE_AI_ORG_ID
#   5. Same tab → scroll to Request Headers → cookie line → find "sessionKey=..."
#      → copy everything from sk-ant-sid02-... up to (but not including) the next ";"
#      → that's CLAUDE_AI_SESSION_KEY
#
# sessionKey rotates every few weeks. Daemon logs a 401/403 warning when
# refresh is needed — repeat the grab and paste the new value.

CLAUDE_AI_SESSION_KEY=sk-ant-sid02-PASTE_HERE
CLAUDE_AI_ORG_ID=00000000-0000-0000-0000-000000000000
